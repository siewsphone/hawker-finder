# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# PostgreSQL (Hawker Finder DB)
PG_HOST=nas
PG_PORT=54321
PG_DB=hawker_finder
PG_USER=postgres
PG_PASSWORD=

# LLM enrichment (OpenCode Zen / Go)
OPENCODE_ZEN_API_KEY=
OPENCODE_GO_API_KEY=

# Web scraping fallback
FIRECRAWL_API_KEY=
